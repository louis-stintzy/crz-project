NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,https://mywebsite.com # Use the service name defined in docker-compose.yml

POSTGRES_USER=user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=crz_project
POSTGRES_HOST=localhost
POSTGRES_PORT=5436

JWT_ACCESS_TOKEN_SECRET=your_jwt_access_token_secret

# AWS S3 configuration
AWS_REGION=eu-west-3
S3_BUCKET_NAME=your-s3-bucket-name

# AWS credentials are provided separately through the AWS credential chain.
# For local development: AWS_PROFILE=crz-dev npm run dev
# Do not store AWS access keys in this file.